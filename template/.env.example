# Application
# APP_ENV: development | staging | production
APP_ENV=development
# SECRET_KEY signs access tokens (JWT) — generate a real random value per environment.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/{{ package_name }}_dev

# External services
# SENTRY_DSN: leave blank to disable locally
SENTRY_DSN=

# Observability (optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
